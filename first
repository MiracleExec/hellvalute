    ["Nikilis Scythe"] = 150000,
}
local DEFAULT_ICON = "rbxassetid://10723345869"

-- 1. Предварительное сканирование базы данных MM2 для получения всех икон
local AssetDatabase = {}
pcall(function()
    local db = ReplicatedStorage:FindFirstChild("Database") or ReplicatedStorage:FindFirstChild("ItemDatabase")
    if db then
        for _, module in ipairs(db:GetDescendants()) do
            if module:IsA("ModuleScript") then
                local success, data = pcall(require, module)
                if success and type(data) == "table" then
                    for itemName, itemDetails in pairs(data) do
                        if type(itemDetails) == "table" then
                            local imgId = itemDetails.Image or itemDetails.Icon or itemDetails.AssetId
                            if imgId then
                                local idOnly = tostring(imgId):match("(%d+)")
                                if idOnly then
                                    AssetDatabase[tostring(itemName)] = "rbxassetid://" .. idOnly
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- 2. Очистка имени предмета от суффиксов
local function CleanItemName(rawName)
    return rawName:gsub("_%a+_%d+", ""):gsub("_%d+", "")
end

-- 3. Извлечение предметов СТРОГО из указанного контейнера
local function GetSalvageItems()
    local items = {}
    
    local targetContainer = PlayerGui:FindFirstChild("MainGUI")
        and PlayerGui.MainGUI:FindFirstChild("Game")
        and PlayerGui.MainGUI.Game:FindFirstChild("Crafting")
        and PlayerGui.MainGUI.Game.Crafting:FindFirstChild("Inventory")
        and PlayerGui.MainGUI.Game.Crafting.Inventory:FindFirstChild("Salvage")
        and PlayerGui.MainGUI.Game.Crafting.Inventory.Salvage:FindFirstChild("ScrollFrame")
        and PlayerGui.MainGUI.Game.Crafting.Inventory.Salvage.ScrollFrame:FindFirstChild("Container")

    if targetContainer then
        for _, itemFrame in ipairs(targetContainer:GetChildren()) do
            if itemFrame:IsA("GuiObject") and itemFrame.Name ~= "Template" and not itemFrame:IsA("UIComponent") then
                local rawName = itemFrame.Name
                local cleanName = CleanItemName(rawName)
                
                -- Сначала ищем картинку прямо внутри элемента
                local finalImage = nil
                local imgObj = itemFrame:FindFirstChildWhichIsA("ImageLabel", true) 
                    or itemFrame:FindFirstChildWhichIsA("ImageButton", true)

                if imgObj and imgObj.Image and imgObj.Image ~= "" and imgObj.Image ~= "nil" then
                    local idOnly = tostring(imgObj.Image):match("(%d+)")
                    if idOnly then
                        finalImage = "rbxassetid://" .. idOnly
                    end
                end

                -- Если картинки в UI нет (не подгрузилась), берем из базы данных игры
                if not finalImage then
                    finalImage = AssetDatabase[cleanName] or AssetDatabase[rawName] or DEFAULT_ICON
                end

                table.insert(items, {
                    rawName = rawName,
                    cleanName = cleanName,
                    image = finalImage
                })
            end
        end
    end

    return items
end

