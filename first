print("[MM2 Helper] Запуск скрипта...")

-- 1. Безопасная загрузка WindUI через список зеркал
local WIND_UI_URLS = {
    "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"
}

local WindUI = nil
for _, url in ipairs(WIND_UI_URLS) do
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if success and result then
        WindUI = result
        break
    end
end

if not WindUI then
    error("[MM2 Helper] Не удалось загрузить WindUI с зеркал!")
    return
end

local Players = game:GetService("Players")
local ContentProvider = game:GetService("ContentProvider")
local LocalPlayer = Players.LocalPlayer

-- База цен предмета (по очищенному имени)
local ItemDatabase = {
    ["Bubbles"] = {value = 10},
    ["Corrupt"] = {value = 1850},
    ["Harvester"] = {value = 1200},
    ["Icepiercer"] = {value = 1150},
    ["Bat"] = {value = 1100},
    ["Nikilis Scythe"] = {value = 150000},
}
local DEFAULT_ICON = "rbxthumb://type=Asset&w=150&h=150&id=10723345869"

-- 2. Функция гарантированного превращения любой ссылки/ID в rbxthumb
local function ToRbxThumb(rawImageContent)
    if not rawImageContent then return DEFAULT_ICON end
    local str = tostring(rawImageContent)

    -- Если это уже rbxthumb ссылка — возвращаем как есть
    if str:find("rbxthumb://") then
        return str
    end

    -- Вытаскиваем ID (числа) из rbxassetid://..., Content объекта или обычного текста
    local assetId = str:match("id=(%d+)") or str:match("(%d+)")
    if assetId then
        return "rbxthumb://type=Asset&w=150&h=150&id=" .. assetId
    end

    return DEFAULT_ICON
end

-- 3. Создание окна UI
local Window = WindUI:CreateWindow({
    Title = "MM2 Inventory Viewer",
    Icon = "box",
    Author = "Simple Viewer",
    Size = UDim2.fromOffset(450, 360),
    Theme = "Dark",
})

local InvTab = Window:Tab({ Title = "Мой Инвентарь", Icon = "layout-grid" })

local InfoParagraph = InvTab:Paragraph({
    Title = "Поиск предметов...",
    Desc = "Загрузка инвентаря...",
})

-- 4. Функция очистки имени ножа/пистолета
local function CleanItemName(rawName)
    return rawName:gsub("_%a+_%d+", ""):gsub("_%d+", "")
end

-- 5. Извлечение картинки из GUI инвентаря MM2
local function GetItemImage(itemFrame)
    if not itemFrame then return DEFAULT_ICON end

    local innerContainer = itemFrame:FindFirstChild("Container")
    if innerContainer then
        local icon = innerContainer:FindFirstChild("Icon")
        if icon and (icon:IsA("ImageLabel") or icon:IsA("ImageButton")) then
            local rawImg = icon.Image
            if rawImg and tostring(rawImg) ~= "" then
                return ToRbxThumb(rawImg)
            end
        end
    end

    local fallbackIcon = itemFrame:FindFirstChildWhichIsA("ImageLabel", true) 
        or itemFrame:FindFirstChildWhichIsA("ImageButton", true)

    if fallbackIcon and fallbackIcon.Image and tostring(fallbackIcon.Image) ~= "" then
        return ToRbxThumb(fallbackIcon.Image)
    end

    return DEFAULT_ICON
end

-- 6. Чтение контейнера инвентаря
local function GetPlayerInventory()
    local inventory = {}
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return inventory end

    local container = playerGui:FindFirstChild("MainGUI")
        and playerGui.MainGUI:FindFirstChild("Game")
        and playerGui.MainGUI.Game:FindFirstChild("Crafting")
        and playerGui.MainGUI.Game.Crafting:FindFirstChild("Inventory")
        and playerGui.MainGUI.Game.Crafting.Inventory:FindFirstChild("Salvage")
        and playerGui.MainGUI.Game.Crafting.Inventory.Salvage:FindFirstChild("ScrollFrame")
        and playerGui.MainGUI.Game.Crafting.Inventory.Salvage.ScrollFrame:FindFirstChild("Container")

    if container then
        for _, itemFrame in ipairs(container:GetChildren()) do
            if itemFrame:IsA("GuiObject") and not itemFrame:IsA("UIGridLayout") and not itemFrame:IsA("UIPadding") then
                local rawName = itemFrame.Name
                local cleanName = CleanItemName(rawName)
                local detectedImage = GetItemImage(itemFrame)

                table.insert(inventory, {
                    cleanName = cleanName,
                    image = detectedImage
                })
            end
        end
    end

    return inventory
end

-- 7. Отрисовка сетки с иконками
local gridFrame = nil

local function ShowInventory()
    if gridFrame then gridFrame:Destroy() end

    local playerItems = GetPlayerInventory()
    local tabContainer = InvTab.Page 

    gridFrame = Instance.new("ScrollingFrame")
    gridFrame.Name = "SimpleInventoryGrid"
    gridFrame.Size = UDim2.new(1, 0, 0, 230)
    gridFrame.BackgroundTransparency = 1
    gridFrame.BorderSizePixel = 0
    gridFrame.ScrollBarThickness = 4
    gridFrame.Parent = tabContainer

    local gridLayout = Instance.new("UIGridLayout")
    gridLayout.CellSize = UDim2.fromOffset(70, 70)
    gridLayout.CellPadding = UDim2.fromOffset(6, 6)
    gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    gridLayout.Parent = gridFrame

    local totalVal = 0

    for _, itemInfo in ipairs(playerItems) do
        local clean = itemInfo.cleanName
        local itemImg = itemInfo.image

        local itemData = ItemDatabase[clean] or {value = 0}
        totalVal = totalVal + itemData.value

        local imgLabel = Instance.new("ImageLabel")
        imgLabel.Image = itemImg
        imgLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        imgLabel.BorderSizePixel = 0
        imgLabel.Parent = gridFrame

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = imgLabel

        task.spawn(function()
            pcall(function()
                ContentProvider:PreloadAsync({imgLabel})
            end)
        end)
    end

    InfoParagraph:SetTitle("Найдено предметов: " .. #playerItems)
    InfoParagraph:SetDesc("Общая стоимость инвентаря: " .. totalVal .. " Val")
end

task.spawn(function()
    task.wait(1)
    ShowInventory()
end)
