-- 4. Функция безопасного поиска инвентаря
local function GetPlayerInventory()
    local inventory = {}
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return inventory end

    local mainGui = playerGui:FindFirstChild("MainGUI")
    if mainGui and mainGui:FindFirstChild("Game") and mainGui.Game:FindFirstChild("Inventory") then
        local invContainer = mainGui.Game.Inventory.Main.Weapons.Items.Container
        for _, category in ipairs(invContainer:GetChildren()) do
            for _, itemBox in ipairs(category:GetChildren()) do
                if itemBox:IsA("Frame") or itemBox:IsA("ImageButton") then
                    table.insert(inventory, itemBox.Name)
                end
            end
        end
    end
    return inventory
end

-- 5. Построение сетки
local gridFrame = nil

local function BuildInventoryGrid()
    if gridFrame then gridFrame:Destroy() end

    local playerItems = GetPlayerInventory()
    local tabContainer = InvTab.Page 

    gridFrame = Instance.new("ScrollingFrame")
    gridFrame.Name = "InventoryGrid"
    gridFrame.Size = UDim2.new(1, 0, 0, 220)
    gridFrame.BackgroundTransparency = 1
    gridFrame.BorderSizePixel = 0
    gridFrame.ScrollBarThickness = 4
    gridFrame.Parent = tabContainer

    local gridLayout = Instance.new("UIGridLayout")
    gridLayout.CellSize = UDim2.fromOffset(80, 80)
    gridLayout.CellPadding = UDim2.fromOffset(8, 8)
    gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    gridLayout.Parent = gridFrame

    local totalVal = 0

    for _, itemName in ipairs(playerItems) do
        local itemData = ItemDatabase[itemName] or {value = 0, image = DEFAULT_ICON}
        totalVal = totalVal + itemData.value

        local btn = Instance.new("ImageButton")
        btn.Name = itemName
        btn.Image = itemData.image
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
        btn.BorderSizePixel = 0
        btn.Parent = gridFrame

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = btn

        local valLabel = Instance.new("TextLabel")
        valLabel.Size = UDim2.new(1, 0, 0, 18)
        valLabel.Position = UDim2.new(0, 0, 1, -18)
        valLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        valLabel.BackgroundTransparency = 0.4
        valLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        valLabel.TextSize = 11
        valLabel.Font = Enum.Font.SourceSansBold
        valLabel.Text = tostring(itemData.value) .. " Val"
        valLabel.Parent = btn

        btn.MouseButton1Click:Connect(function()
            local tradeEvent = ReplicatedStorage:FindFirstChild("Trade") 
                and ReplicatedStorage.Trade:FindFirstChild("OfferItem")
            if tradeEvent then
                tradeEvent:FireServer(itemName)
                WindUI:Notify({
                    Title = "Трейд",
                    Content = "Предмет " .. itemName .. " добавлен в обмен!",
                    Duration = 2,
                })
            end
        end)
    end

    InfoParagraph:SetTitle("Найдено предметов: " .. #playerItems)
    InfoParagraph:SetDesc("Общая стоимость: " .. totalVal .. " Val")
end

InvTab:Button({
    Title = "Обновить инвентарь",
    Callback = function()
        BuildInventoryGrid()
    end,
})

-- Запуск сбора
task.spawn(function()
    task.wait(1)
    BuildInventoryGrid()
end)
