local function RenderInventory()
    local playerItems = GetPlayerInventory()
    local totalVal = 0

    for _, itemInfo in ipairs(playerItems) do
        local clean = itemInfo.cleanName
        local itemImg = itemInfo.image

        local itemData = ItemDatabase[clean] or {value = 0}
        totalVal = totalVal + itemData.value

        local imgLabel = Instance.new("ImageLabel")
        imgLabel.Image = itemImg
        imgLabel.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
        imgLabel.BorderSizePixel = 0
        imgLabel.Parent = scroll

        local imgCorner = Instance.new("UICorner")
        imgCorner.CornerRadius = UDim.new(0, 6)
        imgCorner.Parent = imgLabel

        task.spawn(function()
            pcall(function()
                ContentProvider:PreloadAsync({imgLabel})
            end)
        end)
    end

    infoText.Text = string.format("Найдено предметов: %d\nОбщая стоимость: %d Val", #playerItems, totalVal)
end

task.spawn(function()
    task.wait(0.5)
    RenderInventory()
end)
