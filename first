-- 1. Форматирование ссылки через Thumbs/Asset.ashx
local function ToAssetUrl(rawId)
    if not rawId then return "http://www.roblox.com/Thumbs/Asset.ashx?format=png&width=250&height=250&assetId=10723345869" end
    local str = tostring(rawId)

    local assetId = str:match("id=(%d+)") or str:match("(%d+)")
    if assetId then
        return "http://www.roblox.com/Thumbs/Asset.ashx?format=png&width=250&height=250&assetId=" .. assetId
    end

    return "http://www.roblox.com/Thumbs/Asset.ashx?format=png&width=250&height=250&assetId=10723345869"
end

-- 2. Загрузка базы данных ассетов MM2
local ItemDataModules = {}
pcall(function()
    local db = ReplicatedStorage:FindFirstChild("Database") or ReplicatedStorage:FindFirstChild("ItemDatabase")
    if db then
        for _, module in ipairs(db:GetDescendants()) do
            if module:IsA("ModuleScript") then
                local success, data = pcall(require, module)
                if success and type(data) == "table" then
                    for itemName, itemDetails in pairs(data) do
                        if type(itemDetails) == "table" then
                            ItemDataModules[tostring(itemName)] = itemDetails
                        end
                    end
                end
            end
        end
    end
end)

-- 3. Чтение инвентаря игрока
local function GetFullPlayerInventory()
    local itemsList = {}

    local playerData = nil
    pcall(function()
        local getDataRemote = ReplicatedStorage:FindFirstChild("Remotes") 
            and ReplicatedStorage.Remotes:FindFirstChild("Extras") 
            and ReplicatedStorage.Remotes.Extras:FindFirstChild("GetData")
        
        if getDataRemote and getDataRemote:IsA("RemoteFunction") then
            playerData = getDataRemote:InvokeServer()
        end
    end)

    if playerData and type(playerData) == "table" and playerData.Owned then
        for categoryName, categoryItems in pairs(playerData.Owned) do
            if type(categoryItems) == "table" then
                for itemName, count in pairs(categoryItems) do
                    if count and count > 0 then
                        local itemInfo = ItemDataModules[tostring(itemName)] or {}
                        local imageId = itemInfo.Image or itemInfo.Icon or itemInfo.AssetId
                        
                        table.insert(itemsList, {
                            name = tostring(itemName),
                            image = ToAssetUrl(imageId),
                            count = count
                        })
                    end
                end
            end
        end
    end

    return itemsList
end

