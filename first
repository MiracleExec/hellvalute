local Players = game:GetService("Players")
local ContentProvider = game:GetService("ContentProvider")
local LocalPlayer = Players.LocalPlayer

-- База цен (заполняйте по названию предмета)
local ItemDatabase = {
    ["Bubbles"] = {value = 10},
    ["Corrupt"] = {value = 1850},
    ["Harvester"] = {value = 1200},
    ["Icepiercer"] = {value = 1150},
    ["Bat"] = {value = 1100},
    ["Nikilis Scythe"] = {value = 150000},
}
local DEFAULT_ICON = "rbxassetid://10723345869"

-- 2. Создание окна UI
local Window = WindUI:CreateWindow({
    Title = "MM2 Inventory Viewer",
