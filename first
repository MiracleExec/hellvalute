print("[MM2 Helper] Загрузка скрипта...")

local WIND_UI_URL = "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"

local success, WindUI = pcall(function()
    return loadstring(game:HttpGet(WIND_UI_URL))()
end)

if not success or not WindUI then
    error("[MM2 Helper] Не удалось загрузить WindUI с GitHub!")
    return
end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- База цен предметов (Ключи должны совпадать с очищенным именем cleanName)
local ItemDatabase = {
    ["Bubbles"] = {value = 10, image = "rbxassetid://10723345869"},
    ["Corrupt"] = {value = 1850, image = "rbxassetid://4725513813"},
    ["Harvester"] = {value = 1200, image = "rbxassetid://11303862206"},
    ["Icepiercer"] = {value = 1150, image = "rbxassetid://11822238418"},
    ["Bat"] = {value = 1100, image = "rbxassetid://11303860010"},
}
local DEFAULT_ICON = "rbxassetid://10723345869"

local Window = WindUI:CreateWindow({
    Title = "MM2 Inventory Helper",
    Icon = "box",
    Author = "Value Helper",
    Size = UDim2.fromOffset(460, 380),
    Theme = "Dark",
})

local InvTab = Window:Tab({ Title = "Мой Инвентарь", Icon = "layout-grid" })

local InfoParagraph = InvTab:Paragraph({
    Title = "Статус",
    Desc = "Нажмите 'Обновить инвентарь' для загрузки.",
})

local function CleanItemName(rawName)
    local cleanName = rawName:gsub("_%a+_%d+", ""):gsub("_%d+", "")
    return cleanName
end

local function GetPlayerInventory()
    local inventory = {}
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return inventory end

    local container = playerGui:FindFirstChild("MainGUI")
        and playerGui.MainGUI:FindFirstChild("Game")
        and playerGui.MainGUI.Game:FindFirstChild("Crafting")
        and playerGui.MainGUI.Game.Crafting:FindFirstChild("Inventory")
        and playerGui.MainGUI.Game.Crafting.Inventory:FindFirstChild("Salvage")
        and playerGui.MainGUI.Game.Crafting.Inventory.Salvage:FindFirstChild("ScrollFrame")
        and playerGui.MainGUI.Game.Crafting.Inventory.Salvage.ScrollFrame:FindFirstChild("Container")

    if container then
        for _, itemFrame in ipairs(container:GetChildren()) do
            if itemFrame:IsA("GuiObject") and not itemFrame:IsA("UIGridLayout") and not itemFrame:IsA("UIPadding") then
                table.insert(inventory, {
                    rawName = itemFrame.Name,
                    cleanName = CleanItemName(itemFrame.Name)
                })
            end
        end
    end
    return inventory
end

local gridFrame = nil

local function BuildInventoryGrid()
    if gridFrame then gridFrame:Destroy() end

    local playerItems = GetPlayerInventory()
    local tabContainer = InvTab.Page 

    gridFrame = Instance.new("ScrollingFrame")
    gridFrame.Name = "InventoryGrid"
    gridFrame.Size = UDim2.new(1, 0, 0, 220)
    gridFrame.BackgroundTransparency = 1
    gridFrame.BorderSizePixel = 0
    gridFrame.ScrollBarThickness = 4
    gridFrame.Parent = tabContainer

    local gridLayout = Instance.new("UIGridLayout")
    gridLayout.CellSize = UDim2.fromOffset(80, 80)
    gridLayout.CellPadding = UDim2.fromOffset(8, 8)
    gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    gridLayout.Parent = gridFrame

    local totalVal = 0

    for _, itemDataInfo in ipairs(playerItems) do
        local clean = itemDataInfo.cleanName
        local raw = itemDataInfo.rawName

        local itemData = ItemDatabase[clean] or {value = 0, image = DEFAULT_ICON}
        totalVal = totalVal + itemData.value

        local btn = Instance.new("ImageButton")
        btn.Name = raw
        btn.Image = itemData.image
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
        btn.BorderSizePixel = 0
        btn.Parent = gridFrame

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = btn

        local valLabel = Instance.new("TextLabel")
        valLabel.Size = UDim2.new(1, 0, 0, 18)
        valLabel.Position = UDim2.new(0, 0, 1, -18)
        valLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        valLabel.BackgroundTransparency = 0.4
        valLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        valLabel.TextSize = 10
        valLabel.Font = Enum.Font.SourceSansBold
        valLabel.Text = clean .. "\n" .. tostring(itemData.value) .. " V"
        valLabel.Parent = btn

        btn.MouseButton1Click:Connect(function()
            local tradeEvent = ReplicatedStorage:FindFirstChild("Trade") 
                and ReplicatedStorage.Trade:FindFirstChild("OfferItem")
            if tradeEvent then
                -- Отправляем сырое имя предмета (raw), чтобы игра поняла, о каком предмете речь
                tradeEvent:FireServer(raw)
                WindUI:Notify({
                    Title = "Трейд",
                    Content = "Предмет " .. clean .. " добавлен в обмен!",
                    Duration = 2,
                })
            end
        end)
    end

    InfoParagraph:SetTitle("Найдено предметов: " .. #playerItems)
    InfoParagraph:SetDesc("Общая стоимость: " .. totalVal .. " Val")
end

InvTab:Button({
    Title = "Обновить инвентарь",
    Callback = function()
        BuildInventoryGrid()
    end,
})

task.spawn(function()
    task.wait(1)
    BuildInventoryGrid()
end)
