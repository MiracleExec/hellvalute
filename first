-- 4. Функция очистки имени (например, Bubbles_K_2026 -> Bubbles)
local function CleanItemName(rawName)
    local cleanName = rawName:gsub("_%a+_%d+", ""):gsub("_%d+", "")
    return cleanName
end

-- 5. Парсинг ссылки картинки (Превращает rbxthumb://...&id=138388933477235... в rbxassetid://138388933477235)
local function ExtractAssetUrl(rawImageContent)
    if not rawImageContent then return DEFAULT_ICON end
    local str = tostring(rawImageContent)

    -- Вытаскиваем ID ассета из rbxthumb ссылки
    local assetId = str:match("id=(%d+)")
    if assetId then
        return "rbxassetid://" .. assetId
    end

    if str:find("rbxassetid://") or str:find("rbxthumb://") then
        return str
    end

    return DEFAULT_ICON
end

-- 6. Извлечение иконки прямо из объекта предмета в GUI MM2 (.Container.Icon)
local function GetItemImage(itemFrame)
    local innerContainer = itemFrame:FindFirstChild("Container")
    if innerContainer then
        local icon = innerContainer:FindFirstChild("Icon")
        if icon then
            local rawImg = icon.Image
            if rawImg and tostring(rawImg) ~= "" then
                return ExtractAssetUrl(rawImg)
            end
        end
    end

    -- Резервный поиск, если структура немного отличается
    local fallbackIcon = itemFrame:FindFirstChildWhichIsA("ImageLabel", true) 
        or itemFrame:FindFirstChildWhichIsA("ImageButton", true)

    if fallbackIcon and fallbackIcon.Image then
        return ExtractAssetUrl(fallbackIcon.Image)
    end

    return DEFAULT_ICON
end

-- 7. Сканирование вашего инвентаря
local function GetPlayerInventory()
    local inventory = {}
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return inventory end

    local container = playerGui:FindFirstChild("MainGUI")
        and playerGui.MainGUI:FindFirstChild("Game")
        and playerGui.MainGUI.Game:FindFirstChild("Crafting")
        and playerGui.MainGUI.Game.Crafting:FindFirstChild("Inventory")
        and playerGui.MainGUI.Game.Crafting.Inventory:FindFirstChild("Salvage")
        and playerGui.MainGUI.Game.Crafting.Inventory.Salvage:FindFirstChild("ScrollFrame")
        and playerGui.MainGUI.Game.Crafting.Inventory.Salvage.ScrollFrame:FindFirstChild("Container")

    if container then
        for _, itemFrame in ipairs(container:GetChildren()) do
            if itemFrame:IsA("GuiObject") and not itemFrame:IsA("UIGridLayout") and not itemFrame:IsA("UIPadding") then
                local rawName = itemFrame.Name
                local cleanName = CleanItemName(rawName)
                local detectedImage = GetItemImage(itemFrame)

                table.insert(inventory, {
                    rawName = rawName,
                    cleanName = cleanName,
                    image = detectedImage
                })
            end
        end
    else
        warn("[MM2 Helper] Контейнер инвентаря не найден. Откройте окно крафта/инвентаря в игре!")
    end

    return inventory
end

-- 8. Отрисовка кастомной сетки инвентаря
local gridFrame = nil

local function BuildInventoryGrid()
    if gridFrame then gridFrame:Destroy() end

    local playerItems = GetPlayerInventory()
    local tabContainer = InvTab.Page 

    gridFrame = Instance.new("ScrollingFrame")
    gridFrame.Name = "InventoryGrid"
    gridFrame.Size = UDim2.new(1, 0, 0, 220)
    gridFrame.BackgroundTransparency = 1
    gridFrame.BorderSizePixel = 0
    gridFrame.ScrollBarThickness = 4
    gridFrame.Parent = tabContainer

    local gridLayout = Instance.new("UIGridLayout")
    gridLayout.CellSize = UDim2.fromOffset(80, 80)
    gridLayout.CellPadding = UDim2.fromOffset(8, 8)
    gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    gridLayout.Parent = gridFrame

    local totalVal = 0

    for _, itemInfo in ipairs(playerItems) do
        local clean = itemInfo.cleanName
        local raw = itemInfo.rawName
        local itemImg = itemInfo.image

        local itemData = ItemDatabase[clean] or {value = 0}
        totalVal = totalVal + itemData.value

        local btn = Instance.new("ImageButton")
        btn.Name = raw
        btn.Image = itemImg
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
        btn.BorderSizePixel = 0
        btn.Parent = gridFrame

        -- Предзагрузка ассета картинки в память клиента
        task.spawn(function()
            pcall(function()
                ContentProvider:PreloadAsync({btn})
            end)
        end)

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = btn

        local valLabel = Instance.new("TextLabel")
        valLabel.Size = UDim2.new(1, 0, 0, 22)
        valLabel.Position = UDim2.new(0, 0, 1, -22)
        valLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        valLabel.BackgroundTransparency = 0.4
        valLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        valLabel.TextSize = 10
        valLabel.Font = Enum.Font.SourceSansBold
        valLabel.Text = clean .. "\n" .. tostring(itemData.value) .. " V"
        valLabel.Parent = btn

        -- При клике добавляем предмет в реальный трейд MM2
        btn.MouseButton1Click:Connect(function()
            local tradeEvent = ReplicatedStorage:FindFirstChild("Trade") 
                and ReplicatedStorage.Trade:FindFirstChild("OfferItem")
            if tradeEvent then
                tradeEvent:FireServer(raw)
                WindUI:Notify({
                    Title = "Трейд",
                    Content = "Предмет " .. clean .. " добавлен в обмен!",
                    Duration = 2,
                })
            else
                WindUI:Notify({
                    Title = "Ошибка",
                    Content = "Окно трейда в MM2 не открыто!",
                    Duration = 2,
                })
            end
        end)
    end

    InfoParagraph:SetTitle("Найдено предметов: " .. #playerItems)
    InfoParagraph:SetDesc("Общая стоимость инвентаря: " .. totalVal .. " Val")
end

-- Кнопка ручной перезагрузки
InvTab:Button({
    Title = "Обновить инвентарь",
    Callback = function()
        BuildInventoryGrid()
    end,
})

-- Автоматический запуск генерации сетки при включении
task.spawn(function()
    task.wait(1)
    BuildInventoryGrid()
end)
