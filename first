-- 1. Поиск оригинальных визуальных элементов инвентаря MM2
local function FindGameInventoryContainers()
    local containers = {}
    local mainGui = PlayerGui:FindFirstChild("MainGUI")
    
    if mainGui then
        -- Поиск всех ScrollingFrame и Container внутри GUI инвентаря
        for _, desc in ipairs(mainGui:GetDescendants()) do
            if (desc.Name == "Container" or desc.Name == "ScrollFrame") and #desc:GetChildren() > 0 then
                local hasGuiItems = false
                for _, child in ipairs(desc:GetChildren()) do
                    if child:IsA("GuiObject") and not child:IsA("UIComponent") then
                        hasGuiItems = true
                        break
                    end
                end
                if hasGuiItems then
                    table.insert(containers, desc)
                end
            end
        end
    end
    return containers
end

