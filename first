local ItemDatabase = {
    ["Bubbles"] = {value = 10},
    ["Corrupt"] = {value = 1850},
    ["Harvester"] = {value = 1200},
    ["Icepiercer"] = {value = 1150},
    ["Bat"] = {value = 1100},
