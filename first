-- 3. Отрисовка с извлечением картинок напрямую из UI предметов
local function RenderInventory()
    local containers = FindGameInventoryContainers()
    local addedItems = {}
    local itemCount = 0
    local totalVal = 0

    for _, container in ipairs(containers) do
        for _, itemFrame in ipairs(container:GetChildren()) do
            if itemFrame:IsA("GuiObject") and not itemFrame:IsA("UIComponent") then
                local rawName = itemFrame.Name
                
                -- Игнорируем технические элементы
                if rawName ~= "Template" and not addedItems[itemFrame] then
                    addedItems[itemFrame] = true
                    
                    -- Ищем картинку внутри рамочки
                    local imgObj = itemFrame:FindFirstChildWhichIsA("ImageLabel", true) 
                        or itemFrame:FindFirstChildWhichIsA("ImageButton", true)
                    
                    local cleanName = rawName:gsub("_%a+_%d+", ""):gsub("_%d+", "")
                    local itemValue = ItemDatabaseValues[cleanName] or 0
                    totalVal = totalVal + itemValue
                    itemCount = itemCount + 1

                    -- Создаем карточку предмета
                    local card = Instance.new("Frame")
                    card.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
                    card.BorderSizePixel = 0
                    card.Parent = scroll

                    local cardCorner = Instance.new("UICorner")
                    cardCorner.CornerRadius = UDim.new(0, 6)
                    cardCorner.Parent = card

                    if imgObj and imgObj.Image and imgObj.Image ~= "" then
                        local iconClone = Instance.new("ImageLabel")
                        iconClone.Size = UDim2.new(1, -8, 1, -8)
                        iconClone.Position = UDim2.new(0, 4, 0, 4)
                        iconClone.BackgroundTransparency = 1
                        iconClone.Image = imgObj.Image
                        iconClone.Parent = card
                    else
                        -- Если картинки нет, пишем название предмета
                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.new(1, -4, 1, -4)
                        lbl.Position = UDim2.new(0, 2, 0, 2)
                        lbl.BackgroundTransparency = 1
                        lbl.Text = cleanName
                        lbl.TextColor3 = Color3.fromRGB(220, 220, 220)
                        lbl.TextSize = 10
                        lbl.TextWrapped = true
                        lbl.Font = Enum.Font.SourceSans
                        lbl.Parent = card
                    end
                end
            end
        end
    end

    infoText.Text = string.format("Найдено предметов: %d\nОбщая стоимость: %d Val", itemCount, totalVal)
end

task.spawn(function()
    task.wait(0.3)
