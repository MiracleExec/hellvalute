local function RenderInventory()
    local inventory = GetFullPlayerInventory()
    local totalItems = 0
    local totalValue = 0

    for _, item in ipairs(inventory) do
        totalItems = totalItems + (item.count or 1)
        local val = ItemDatabaseValues[item.name] or 0
        totalValue = totalValue + (val * (item.count or 1))

        local imgLabel = Instance.new("ImageLabel")
        imgLabel.Image = item.image
        imgLabel.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
        imgLabel.BorderSizePixel = 0
        imgLabel.Parent = scroll

        local imgCorner = Instance.new("UICorner")
        imgCorner.CornerRadius = UDim.new(0, 6)
        imgCorner.Parent = imgLabel

        if item.count and item.count > 1 then
            local countBadge = Instance.new("TextLabel")
            countBadge.Size = UDim2.fromOffset(20, 14)
            countBadge.Position = UDim2.new(1, -22, 1, -16)
            countBadge.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            countBadge.BackgroundTransparency = 0.3
            countBadge.TextColor3 = Color3.fromRGB(255, 255, 255)
            countBadge.TextSize = 10
            countBadge.Font = Enum.Font.SourceSansBold
            countBadge.Text = "x" .. item.count
            countBadge.Parent = imgLabel

            local bCorner = Instance.new("UICorner")
            bCorner.CornerRadius = UDim.new(0, 4)
            bCorner.Parent = countBadge
        end

        task.spawn(function()
            pcall(function()
                ContentProvider:PreloadAsync({imgLabel})
            end)
        end)
    end

    infoText.Text = string.format("Найдено предметов: %d\nОбщая стоимость: %d Val", totalItems, totalValue)
end

task.spawn(function()
    task.wait(0.3)
    RenderInventory()
end)
