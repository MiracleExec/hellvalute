-- 5. Отрисовка
local function RenderInventory()
    local salvageItems = GetSalvageItems()
    local totalVal = 0

    for _, item in ipairs(salvageItems) do
        local val = ItemDatabaseValues[item.cleanName] or 0
        totalVal = totalVal + val

        local card = Instance.new("Frame")
        card.BackgroundColor3 = Color3.fromRGB(32, 32, 40)
        card.BorderSizePixel = 0
        card.Parent = scroll

        local cardCorner = Instance.new("UICorner")
        cardCorner.CornerRadius = UDim.new(0, 6)
        cardCorner.Parent = card

        local imgLabel = Instance.new("ImageLabel")
        imgLabel.Size = UDim2.new(1, -8, 1, -8)
        imgLabel.Position = UDim2.new(0, 4, 0, 4)
        imgLabel.BackgroundTransparency = 1
        imgLabel.Image = item.image
        imgLabel.Parent = card

        task.spawn(function()
            pcall(function()
                ContentProvider:PreloadAsync({imgLabel})
            end)
        end)
    end

    infoText.Text = string.format("Предметов в Salvage: %d\nОбщая стоимость: %d Val", #salvageItems, totalVal)
end

task.spawn(function()
    task.wait(0.2)
    RenderInventory()
end)
