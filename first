local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- 1. Подключение библиотеки WindUI
local WindUI = loadstring(game:HttpGet("https://tree-hub.vercel.app/api/UI/WindUI"))()

-- 2. База данных цен и ID иконок предметов MM2
local ItemDatabase = {
    ["Corrupt"] = {value = 1850, image = "rbxassetid://4725513813"},
    ["Harvester"] = {value = 1200, image = "rbxassetid://11303862206"},
    ["Icepiercer"] = {value = 1150, image = "rbxassetid://11822238418"},
    ["Bat"] = {value = 1100, image = "rbxassetid://11303860010"},
    ["Chroma Lightbringer"] = {value = 320, image = "rbxassetid://4725514000"},
}

-- Fallback иконка, если предмета нет в локальной базе
local DEFAULT_ICON = "rbxassetid://10723345869"

-- 3. Создание окна WindUI
local Window = WindUI:CreateWindow({
    Title = "MM2 Inventory Helper",
    Icon = "box",
    Author = "Value Helper",
    Size = UDim2.fromOffset(460, 380),
    Theme = "Dark",
})

local InvTab = Window:Tab({ Title = "Мой Инвентарь", Icon = "layout-grid" })

-- Информационная панель над сеткой
local InfoParagraph = InvTab:Paragraph({
    Title = "Инвентарь не загружен",
    Desc = "Нажмите 'Обновить инвентарь', чтобы загрузить предметы.",
})

-- 4. Функция сканирования инвентаря MM2
local function GetPlayerInventory()
    local inventory = {}
    
    -- Сканируем GUI инвентаря MM2
    local mainGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("MainGUI")
    if mainGui and mainGui:FindFirstChild("Game") and mainGui.Game:FindFirstChild("Inventory") then
        local invContainer = mainGui.Game.Inventory.Main.Weapons.Items.Container
        
        for _, category in ipairs(invContainer:GetChildren()) do
            for _, itemBox in ipairs(category:GetChildren()) do
                if itemBox:IsA("Frame") or itemBox:IsA("ImageButton") then
                    table.insert(inventory, itemBox.Name)
                end
            end
        end
    end
    
    return inventory
end

-- 5. Построение сетки UIGridLayout внутри WindUI
local gridFrame = nil

local function BuildInventoryGrid()
    -- Удаляем старую сетку, если она уже создана
    if gridFrame then
        gridFrame:Destroy()
    end

    local playerItems = GetPlayerInventory()
    
    -- Получаем доступ к родительскому UI-контейнеру вкладки WindUI
    local tabContainer = InvTab.Page -- Внутренний Frame страницы вкладки
    
    -- Создаем ScrollingFrame для сетки
    gridFrame = Instance.new("ScrollingFrame")
    gridFrame.Name = "InventoryGrid"
    gridFrame.Size = UDim2.new(1, 0, 0, 220)
    gridFrame.BackgroundTransparency = 1
    gridFrame.BorderSizePixel = 0
    gridFrame.ScrollBarThickness = 4
    gridFrame.Parent = tabContainer

    -- Настраиваем UIGridLayout (сетка 4x4)
    local gridLayout = Instance.new("UIGridLayout")
    gridLayout.CellSize = UDim2.fromOffset(80, 80)
    gridLayout.CellPadding = UDim2.fromOffset(8, 8)
    gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    gridLayout.Parent = gridFrame

    local totalVal = 0

    -- Отрисовка карточек предметов
    for _, itemName in ipairs(playerItems) do
        local itemData = ItemDatabase[itemName] or {value = 0, image = DEFAULT_ICON}
        totalVal = totalVal + itemData.value

        -- Кнопка предмета
        local btn = Instance.new("ImageButton")
        btn.Name = itemName
        btn.Image = itemData.image
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
        btn.BorderSizePixel = 0
        btn.Parent = gridFrame

        -- Закругление углов (UICorner)
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = btn

        -- Текст ценности предмета поверх иконки
        local valLabel = Instance.new("TextLabel")
        valLabel.Size = UDim2.new(1, 0, 0, 18)
        valLabel.Position = UDim2.new(0, 0, 1, -18)
        valLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        valLabel.BackgroundTransparency = 0.4
        valLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        valLabel.TextSize = 11
        valLabel.Font = Enum.Font.SourceSansBold
        valLabel.Text = tostring(itemData.value) .. " Val"
        valLabel.Parent = btn

        -- Клик по предмету: добавление в трейд MM2
        btn.MouseButton1Click:Connect(function()
            local tradeEvent = ReplicatedStorage:FindFirstChild("Trade") 
                and ReplicatedStorage.Trade:FindFirstChild("OfferItem")
            
            if tradeEvent then
                tradeEvent:FireServer(itemName)
                WindUI:Notify({
                    Title = "Трейд",
                    Content = "Предмет " .. itemName .. " добавлен в обмен!",
                    Duration = 2,
                })
            end
        end)
    end

    InfoParagraph:SetTitle("Найдено предметов: " .. #playerItems)
    InfoParagraph:SetDesc("Общая стоимость инвентаря: " .. totalVal .. " Val")
end

-- Кнопка ручного обновления сетки
InvTab:Button({
    Title = "Обновить инвентарь",
    Callback = function()
        BuildInventoryGrid()
    end,
})

-- Первичная сборка сетки при запуске
task.delay(1, BuildInventoryGrid)
